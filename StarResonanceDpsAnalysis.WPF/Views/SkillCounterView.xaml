<Window
    x:Class="StarResonanceDpsAnalysis.WPF.Views.SkillCounterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:StarResonanceDpsAnalysis.WPF.ViewModels"
    xmlns:sc="clr-namespace:StarResonanceDpsAnalysis.WPF.SkillCounter"
    xmlns:conv="clr-namespace:StarResonanceDpsAnalysis.WPF.Converters"
    mc:Ignorable="d"
    Title="스킬 카운터"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ResizeMode="NoResize"
    d:DataContext="{d:DesignInstance vm:SkillCounterViewModel}">

    <Window.Resources>
        <conv:ColorStringToBrushConverter x:Key="ColorStringToBrushConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 충전 완료 글로우 테두리 스타일 -->
        <Style x:Key="AuraCardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#1E1E3A"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="70"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCharged}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFCC00"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFCC00" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 프로그레스바 기본 스타일 -->
        <Style x:Key="AuraProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="#333355"/>
            <Setter Property="Foreground" Value="#1690F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCharged}" Value="True">
                    <Setter Property="Foreground" Value="#FFCC00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 헤더 버튼 스타일 -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 메인 컨테이너 -->
    <Border
        Background="#CC1A1A2E"
        CornerRadius="10"
        Padding="8,6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel MinWidth="120">
            <!-- 헤더 (드래그 바) -->
            <Border
                x:Name="DragBar"
                Background="Transparent"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                Padding="2,0,2,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="⚡ 스킬 카운터"
                        Foreground="#8888AA"
                        FontSize="10"
                        VerticalAlignment="Center"/>

                    <!-- 에디터 열기 -->
                    <Button
                        Grid.Column="1"
                        Content="⚙"
                        ToolTip="편집"
                        Style="{StaticResource HeaderButtonStyle}"
                        Margin="2,0"
                        Click="OpenEditor_Click"/>

                    <!-- 전체 초기화 -->
                    <Button
                        Grid.Column="2"
                        Content="↺"
                        ToolTip="전체 초기화"
                        Style="{StaticResource HeaderButtonStyle}"
                        Command="{Binding ResetAllCommand}"/>
                </Grid>
            </Border>

            <!-- 오라 목록 -->
            <ItemsControl ItemsSource="{Binding Auras}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" MaxWidth="500"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sc:SkillAuraState}">
                        <Border Style="{StaticResource AuraCardBorderStyle}" ToolTip="{Binding Config.Name}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                </Grid.RowDefinitions>

                                <!-- 아이콘 영역 -->
                                <Border
                                    Grid.Row="0"
                                    CornerRadius="6,6,0,0"
                                    Margin="4,4,4,0"
                                    Background="{Binding Config.IconColor, Converter={StaticResource ColorStringToBrushConverter}}">
                                    <Grid>
                                        <TextBlock
                                            Text="{Binding Config.IconText}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            FontSize="22"
                                            FontWeight="Bold"/>

                                        <!-- 충전 완료 체크 뱃지 -->
                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#DDFFCC00"
                                            CornerRadius="0,6,0,4"
                                            Padding="3,1"
                                            Visibility="{Binding IsCharged, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="✓" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 카운트 텍스트 -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{Binding CountText}"
                                    HorizontalAlignment="Center"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,2,0,2"/>

                                <!-- 프로그레스 바 -->
                                <ProgressBar
                                    Grid.Row="2"
                                    Style="{StaticResource AuraProgressBarStyle}"
                                    Value="{Binding Progress}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 오라가 없을 때 안내 -->
            <TextBlock
                Text="⚙ 편집으로 카운터를 추가하세요"
                Foreground="#555577"
                FontSize="10"
                Margin="4,4"
                HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Auras.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
