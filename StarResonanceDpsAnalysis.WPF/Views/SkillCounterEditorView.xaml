<Window
    x:Class="StarResonanceDpsAnalysis.WPF.Views.SkillCounterEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:StarResonanceDpsAnalysis.WPF.ViewModels"
    xmlns:sc="clr-namespace:StarResonanceDpsAnalysis.WPF.SkillCounter"
    xmlns:conv="clr-namespace:StarResonanceDpsAnalysis.WPF.Converters"
    mc:Ignorable="d"
    Title="⚡ 스킬 카운터 편집기"
    Width="720" Height="500"
    MinWidth="600" MinHeight="400"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    WindowStyle="None"
    AllowsTransparency="True"
    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
    d:DataContext="{d:DesignInstance vm:SkillCounterViewModel}">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveConfigCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:ColorStringToBrushConverter x:Key="ColorStringToBrushConverter"/>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="#DDDDFF"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#1690F8"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8888AA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1690F8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2AA0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#CC4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EE5555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#333355"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444477"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuraListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCEE"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#252548"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E1E3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" ClipToBounds="True">
        <DockPanel Background="#1A1A2E">
            <!-- 상단 타이틀 바 -->
            <Border DockPanel.Dock="Top" Background="#0F0F20" Height="36" Cursor="SizeAll">
                <Grid Margin="12,0">
                    <TextBlock Text="⚡ 스킬 카운터 편집기" Foreground="#AAAACC" VerticalAlignment="Center" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button
                            Content="💾 저장 (Ctrl+S)"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Command="{Binding SaveConfigCommand}"/>
                        <Button
                            Content="✕"
                            Width="28" Height="28"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="0"
                            Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 하단 상태바 -->
            <Border DockPanel.Dock="Bottom" Background="#0F0F20" Height="24" Padding="12,0">
                <TextBlock
                    Text="스킬 ID: 인게임 패킷 캡처로 자동 수집됩니다. 이름 조회로 확인하세요."
                    Foreground="#444466"
                    FontSize="10"
                    VerticalAlignment="Center"/>
            </Border>

            <!-- 메인 영역 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 오라 목록 -->
                <Grid Grid.Column="0" Background="#14142A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10" BorderBrush="#333355" BorderThickness="0,0,0,1">
                        <TextBlock Text="카운터 목록" Foreground="#AAAACC" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding EditItems}"
                        SelectedItem="{Binding SelectedEditItem, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        ItemContainerStyle="{StaticResource AuraListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type sc:SkillAuraEditItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="28" Height="28"
                                        CornerRadius="5"
                                        Background="{Binding IconColor, Converter={StaticResource ColorStringToBrushConverter}}"
                                        Margin="0,0,8,0">
                                        <TextBlock
                                            Text="{Binding IconText}"
                                            Foreground="White"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#DDDDFF" FontSize="12"/>
                                        <TextBlock
                                            Text="{Binding TriggerSkillIdText, StringFormat='ID: {0}'}"
                                            Foreground="#666688"
                                            FontSize="10"/>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="OFF"
                                        Foreground="#CC4444"
                                        FontSize="9"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8" HorizontalAlignment="Center">
                        <Button Content="+ 추가" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddAuraCommand}" Margin="0,0,6,0"/>
                        <Button Content="삭제" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteAuraCommand}" CommandParameter="{Binding SelectedEditItem}"/>
                    </StackPanel>
                </Grid>

                <!-- 구분선 -->
                <Rectangle Grid.Column="1" Fill="#333355"/>

                <!-- 오른쪽: 편집 폼 -->
                <Grid Grid.Column="2">
                    <!-- 선택 없을 때 안내 -->
                    <TextBlock
                        Text="왼쪽에서 카운터를 선택하거나 추가하세요"
                        Foreground="#555577"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEditItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 편집 폼 (선택된 항목이 있을 때만 표시) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEditItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel Margin="20,16" DataContext="{Binding SelectedEditItem}">
                            <TextBlock Text="카운터 편집" Foreground="#CCCCFF" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <!-- 활성화 -->
                            <CheckBox Content="활성화" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="#DDDDFF" Margin="0,0,0,12"/>

                            <!-- 이름 -->
                            <TextBlock Text="표시 이름" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>

                            <!-- 아이콘 설정 -->
                            <TextBlock Text="아이콘" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 미리보기 -->
                                <Border
                                    Grid.Column="0"
                                    Width="52" Height="52"
                                    CornerRadius="8"
                                    Background="{Binding IconColor, Converter={StaticResource ColorStringToBrushConverter}}">
                                    <TextBlock
                                        Text="{Binding IconText}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="22"
                                        FontWeight="Bold"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="표시 글자 (최대 2자)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox
                                        Text="{Binding IconText, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        MaxLength="2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Text="색상 (HEX)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                    <TextBox
                                        Text="{Binding IconColor, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DarkTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 구분선 -->
                            <Rectangle Height="1" Fill="#333355" Margin="0,14,0,0"/>

                            <!-- 트리거 스킬 -->
                            <TextBlock Text="카운트할 스킬 ID (트리거)" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Text="{Binding TriggerSkillIdText, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"/>
                                <Button
                                    Grid.Column="2"
                                    Content="이름 조회"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,4"
                                    Click="LookupTriggerSkill_Click"/>
                            </Grid>
                            <!-- 스킬 이름 표시 (이름이 있을 때만) -->
                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#44AAFF">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerSkillName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="→ "/><Run Text="{Binding TriggerSkillName}"/>
                            </TextBlock>

                            <!-- 임계값 -->
                            <TextBlock Text="충전 임계값 (N번 사용 시 충전 완료)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox
                                Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                Width="80"
                                HorizontalAlignment="Left"/>

                            <!-- 구분선 -->
                            <Rectangle Height="1" Fill="#333355" Margin="0,14,0,0"/>

                            <!-- 리셋 스킬 -->
                            <TextBlock Text="카운트 리셋 스킬 ID (강화 스킬)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock
                                Text="※ 비워두면 리셋 없이 임계값 이후에도 계속 카운트됩니다"
                                Foreground="#555577"
                                FontSize="10"
                                Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Text="{Binding ResetSkillIdText, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"/>
                                <Button
                                    Grid.Column="2"
                                    Content="이름 조회"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,4"
                                    Click="LookupResetSkill_Click"/>
                            </Grid>
                            <!-- 리셋 스킬 이름 표시 -->
                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#44AAFF">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResetSkillName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="→ "/><Run Text="{Binding ResetSkillName}"/>
                            </TextBlock>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
